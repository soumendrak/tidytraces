---
import '../styles/main.scss';
import PWAInstallBanner from '../components/PWAInstallBanner.astro';
import { SITE_METADATA } from '../config';
import pwaPromptScript from '../scripts/pwa-prompt.js?raw';

interface Props {
	title?: string;
	description?: string;
	image?: string;
	type?: 'website' | 'article';
	publishedTime?: string;
	jsonLd?: Record<string, any> | Record<string, any>[];
	markdownUrl?: string;
}

const {
	title = 'AI Observability Daily — Tidy Traces',
	description = SITE_METADATA.description,
	image = new URL('/brand/tidytraces-social.png', Astro.site).toString(),
	type = 'website',
	publishedTime,
	jsonLd,
	markdownUrl,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = image;
const siteName = 'Tidy Traces';

const gaId = import.meta.env.PUBLIC_GA_ID || "";

const baseSchemaGraph: Record<string, unknown>[] = [{
  '@type': 'WebSite',
  '@id': `${Astro.site}#website`,
  url: String(Astro.site),
  name: SITE_METADATA.name,
  alternateName: 'AI Observability Daily',
  description: SITE_METADATA.description,
  creator: {
    '@type': 'Person',
    name: SITE_METADATA.creator.name,
    url: SITE_METADATA.creator.url,
  },
}];

if (jsonLd) {
	if (Array.isArray(jsonLd)) {
		baseSchemaGraph.push(...jsonLd);
	} else {
		baseSchemaGraph.push(jsonLd);
	}
}

const schemaMarkup = {
	"@context": "https://schema.org",
	"@graph": baseSchemaGraph
};
---

<!doctype html>
<html lang="en">
	<head>
		<link rel="stylesheet" href="/fonts/newspaper.css" />
		<!-- Performance & Core Web Vitals Resource Hints -->
		<link rel="preconnect" href="https://tdd-edge.b-cdn.net" crossorigin />
		<link rel="dns-prefetch" href="https://tdd-edge.b-cdn.net" />
		{gaId && <link rel="preconnect" href="https://www.googletagmanager.com" />}

		{gaId && (
			<>
				<!-- Google tag (gtag.js) -->
				<script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
				<script is:inline set:html={`
					window.dataLayer = window.dataLayer || [];
					function gtag(){dataLayer.push(arguments);}
					gtag('js', new Date());
					gtag('config', '${gaId}');
				`} />
			</>
		)}
		<script is:inline src="https://rybbit.ekathi.com/api/script.js?siteId=90a6b1d6c9d4" defer></script>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/brand/tidytraces-mark.svg">
		<link rel="icon" type="image/png" sizes="32x32" href="/brand/tidytraces-icon-32.png">
		<link rel="icon" type="image/png" sizes="192x192" href="/brand/tidytraces-icon-192.png">
		<link rel="apple-touch-icon" sizes="180x180" href="/brand/tidytraces-icon-180.png">
		<meta name="msapplication-TileColor" content="#ffffff">
		<meta name="msapplication-TileImage" content="/brand/tidytraces-icon-192.png">

		<!-- Autodiscovery Feeds & Machine-Readable Endpoints -->
		<link rel="alternate" type="application/rss+xml" title="AI Observability Daily" href="/rss.xml" />
		<link rel="alternate" type="text/markdown" href="/md" title="Latest Edition (Markdown Feed for LLMs & Readers)" />
		<link rel="alternate" type="application/json" href="/json" title="Latest Edition (JSON Feed for AI & APIs)" />
		{markdownUrl && (
			<link rel="alternate" type="text/markdown" href={markdownUrl} title="Edition Plaintext (Markdown for LLMs)" />
		)}

		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />

		<!-- Author, SEO & AI Engine (GEO) Directives -->
		<meta name="author" content={SITE_METADATA.creator.name} />
		<link rel="author" href={SITE_METADATA.creator.url} />
		<meta name="publisher" content={siteName} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

		<!-- PWA Metadata and iOS support -->
		<link rel="manifest" href="/manifest.webmanifest?v=2" />
		<script is:inline set:html={pwaPromptScript} />
		<meta name="theme-color" content="#111111" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

		<!-- OpenGraph / Facebook -->
		<meta property="og:type" content={type} />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={socialImageURL} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="628" />
		{publishedTime && <meta property="article:published_time" content={publishedTime} />}

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />


		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImageURL} />
		<meta name="twitter:image:alt" content={title} />

		<!-- Schema.org JSON-LD for SEO & Generative Engine Optimization (GEO) -->
		<script type="application/ld+json" is:inline set:html={JSON.stringify(schemaMarkup)} />
		<script is:inline>
			(function () {
				const savedTheme = localStorage.getItem('theme');
				const theme = savedTheme || 'light';
				document.documentElement.dataset.theme = theme;

				window.addEventListener('DOMContentLoaded', () => {
					const themeToggle = document.getElementById('theme-toggle');
					if (themeToggle) {
						themeToggle.addEventListener('click', () => {
							const current = document.documentElement.dataset.theme || 'light';
							const next = current === 'dark' ? 'light' : 'dark';
							document.documentElement.dataset.theme = next;
							localStorage.setItem('theme', next);
							window.dispatchEvent(new CustomEvent('theme-changed', { detail: next }));
						});
					}
				});
			})();
		</script>
		<script is:inline>
			if ('serviceWorker' in navigator) {
				window.addEventListener('load', () => {
					navigator.serviceWorker.getRegistrations().then((registrations) => {
						// 1. Proactively unregister any legacy or versioned service workers
						for (const reg of registrations) {
							if (reg.active && (reg.active.scriptURL.includes('?v=') || !reg.active.scriptURL.endsWith('/sw.js'))) {
								reg.unregister().then(() => {
									console.log('Successfully removed old versioned service worker:', reg.active.scriptURL);
								});
							}
						}

						// 2. Register the stable, clean, non-versioned service worker
						navigator.serviceWorker.register('/sw.js')
							.then((reg) => {
								console.log('PWA ServiceWorker Active:', reg.scope);
								if (reg) {
									reg.update(); // Force immediate update check
								}
							})
							.catch((err) => console.warn('PWA ServiceWorker Failed:', err));
					});
				});
			}
		</script>
	</head>
	<body>
		<slot />
		<PWAInstallBanner />
		<script src="../scripts/search-shortcut.ts"></script>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
	}
</style>
