---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ThemeToggleButton from './ThemeToggleButton.astro';
import Footer from './Footer.astro';
import BrandLogo from './BrandLogo.astro';
import { publicationStreaks } from '../lib/publicationStreaks.js';

const editions = await getCollection('observability');
const editionName = 'AI Observability';
const archiveHref = '/archive/';
const homeHref = '/';
const issueHref = (day: string) => `/ai-observability/${day}/`;

const chronological = [...editions].sort((a, b) => a.data.date.localeCompare(b.data.date));

const days = chronological.map((edition, index) => {
	const dateObj = new Date(`${edition.data.date}T00:00:00`);
	return {
		day: edition.data.date,
		count: edition.data.stories.length,
		issue: index + 1,
		year: dateObj.getFullYear(),
		month: dateObj.getMonth(), // 0-indexed
		date: dateObj.getDate(),
		dayOfWeek: dateObj.getDay(), // 0 = Sunday
		label: dateObj.toLocaleDateString('en-US', {
			weekday: 'short',
			year: 'numeric',
			month: 'short',
			day: 'numeric',
		}),
	};
});

// Group by Year -> Month -> Array of days
const groupedByYearAndMonth = days.reduce((acc, day) => {
	if (!acc[day.year]) acc[day.year] = {};
	if (!acc[day.year][day.month]) acc[day.year][day.month] = [];
	acc[day.year][day.month].push(day);
	return acc;
}, {} as Record<number, Record<number, typeof days>>);

const years = Object.keys(groupedByYearAndMonth)
	.map(Number)
	.sort((a, b) => b - a);

const latestDay = days.at(-1)?.day;
const streaks = publicationStreaks(days.map((day) => day.day));

const archiveSchema = {
	"@type": "CollectionPage",
	"@id": `${new URL(archiveHref, Astro.site)}#collection`,
	"url": new URL(archiveHref, Astro.site).toString(),
	"name": `Calendar — ${editionName}`,
	"description": `Browse past ${editionName} editions.`,
	"isPartOf": {
		"@type": "WebSite",
		"name": 'Tidy Traces',
		"url": String(Astro.site)
	}
};

const breadcrumbSchema = {
	"@type": "BreadcrumbList",
	"itemListElement": [
		{
			"@type": "ListItem",
			"position": 1,
			"name": 'Tidy Traces',
			"item": String(Astro.site)
		},
		{
			"@type": "ListItem",
			"position": 2,
			"name": "Archive",
			"item": new URL(archiveHref, Astro.site).toString()
		}
	]
};

const itemListSchema = {
	"@type": "ItemList",
	"name": `Past ${editionName} editions`,
	"numberOfItems": days.length,
	"itemListElement": days.slice(-30).reverse().map((d, index) => ({
		"@type": "ListItem",
		"position": index + 1,
		"name": `Issue #${d.issue}: ${d.label}`,
		"url": new URL(issueHref(d.day), Astro.site).toString()
	}))
};

const monthNames = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
const dayNames = ["Su", "Mo", "Tu", "We", "Th", "Fr", "Sa"];
---

<Layout
  title={`${editionName} Calendar — Tidy Traces`}
  description={`Browse every ${editionName} edition by publication date.`}
  jsonLd={[archiveSchema, breadcrumbSchema, itemListSchema]}
>
	<main class="page-container archive-page">
		<BrandLogo compact />
		<header class="archive-header">
			<div class="archive-title-group">
				<h1 class="archive-heading">{editionName} Calendar</h1>
				<span class="archive-count">{days.length} {days.length === 1 ? 'Edition' : 'Editions'}</span>
			</div>
			<div class="archive-actions-group">
				<a class="archive-latest-link" href="/search/">Search</a>
				{latestDay && <a class="archive-latest-link" href={homeHref}>Latest &rsaquo;</a>}
				<ThemeToggleButton />
			</div>
		</header>
		<hr class="archive-rule-thin" />
    <p class="calendar-streaks">Latest publishing streak: <strong>{streaks.latest} {streaks.latest === 1 ? 'day' : 'days'}</strong> · Longest: <strong>{streaks.longest} {streaks.longest === 1 ? 'day' : 'days'}</strong></p>
    <p class="archive-note">Consecutive publication dates, ending at the latest edition. Highlighted days link to an issue; blank days have no issue.</p>



		{
			days.length === 0 ? (
				<div class="empty-state">
					<h3 class="empty-state-title">No Editions Printed Yet</h3>
					<p class="empty-state-desc">No editions have been published for this beat yet.</p>
				</div>
			) : (
				<div class="archive-calendar-list">
					{years.map((year) => (
						<div class="archive-year-section">
							<h2 class="archive-year-heading">{year}</h2>
							<div class="archive-months-grid">
								{Object.keys(groupedByYearAndMonth[year])
									.map(Number)
									.sort((a, b) => b - a)
									.map((month) => {
										const monthDays = groupedByYearAndMonth[year][month];
										// To render a proper calendar grid, we need the first day of the month
										const firstDayOfMonth = new Date(year, month, 1).getDay();
										const daysInMonth = new Date(year, month + 1, 0).getDate();
										
										// Create an array for the grid cells
										const gridCells = Array(firstDayOfMonth + daysInMonth).fill(null);
										monthDays.forEach(dayInfo => {
											// dayInfo.date is 1-indexed. We want 0-indexed offset + firstDayOfMonth
											gridCells[firstDayOfMonth + dayInfo.date - 1] = dayInfo;
										});

										return (
											<div class="archive-month-block">
												<h3 class="archive-month-heading">{monthNames[month]}</h3>
												<div class="archive-calendar-grid">
													{dayNames.map(dayName => (
														<div class="archive-calendar-day-header">{dayName}</div>
													))}
													{gridCells.map((cell, index) => {
														if (index < firstDayOfMonth) {
															return <div class="archive-calendar-cell empty"></div>;
														}
														const dateNum = index - firstDayOfMonth + 1;
														if (cell) {
															return (
																<a href={issueHref(cell.day)} class="archive-calendar-cell active" title={`${cell.day}: ${cell.count} stories`} aria-label={`${cell.day}: ${cell.count} stories`}>
																	<span class="cal-date">{dateNum}</span>
																	<span class="cal-count">{cell.count}</span>
																</a>
															);
														} else {
															return <div class="archive-calendar-cell inactive"><span class="cal-date">{dateNum}</span></div>;
														}
													})}
												</div>
											</div>
										);
									})
								}
							</div>
						</div>
					))}
				</div>
			)
		}
		<Footer />
	</main>
</Layout>
